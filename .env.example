# Nava infrastructure configuration — read automatically by docker compose.
#
# Prefer generating this file for your machine:
#   ./scripts/configure_infra.sh auto        # detect hardware, write .env
#   ./scripts/configure_infra.sh low|medium|high
#
# The defaults below are safe on ANY machine (soft CPU quotas, no pinning).

# Whisper quantisation: int8 (fast, low RAM) | int8_float32 | float32 (most accurate)
WHISPER_COMPUTE_TYPE=int8

# Inference worker pool size per service
STT_WORKERS=2
TTS_WORKERS=2

# BLAS / CTranslate2 / torch threads per service
STT_OMP_THREADS=4
TTS_OMP_THREADS=4

# Soft CPU quota per service (compose "cpus:") — limits, not reservations
STT_CPUS=2.0
TTS_CPUS=2.0

# Optional hard core pinning (compose "cpuset"). EMPTY = disabled — safest
# default; set e.g. STT_CPUSET=0-3 / TTS_CPUSET=4-7 on dedicated machines.
STT_CPUSET=
TTS_CPUSET=

# Memory limits per service
STT_MEM=8g
TTS_MEM=8g
